{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/og/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "image/png" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/daily-digest",
      "schedule": "0 17 * * *"
    }
  ]
}
